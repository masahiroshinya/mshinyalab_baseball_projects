% step4_forstudy_check_single_trial_results.m
%
% 【目的】
%   x3_analyze_single_trial.m で一括処理し、x4_SingleTrialAnalysisResults/ に保存された
%   解析結果（SingleTrialResultArray）を読み込み、反応時間（RT）の位置に赤い縦線を引く
%   可視化スクリプトを自分で作成する練習。
%
% 【workflow.md に従ってコードを書いていこう】
%   STEP 1 から順番に、以下にコードを追記していってください。
%
% -----------------------------------------------------------------------

% --- ここから下にコードを追記してください ---
clear
close all
clc

% 分析対象の設定
iSubject   = 1 ;
iCondition = 1 ;
iTrial     = 1 ;

ConditionNameArray = {'free', 'simple', 'gonogo'} ;
nCondition = length(ConditionNameArray) ;

% 元データ（DataArray)の読み込み
dataFilePath = sprintf('x3_DataChecked/Data%02d', iSubject) ;
load(dataFilePath)

% 解析結果（SingleTrialResultArray)の読み込み
resultFilePath = sprintf('x4_SingleTrialAnalysisResults/SingleTrialAnalysisResults%02d', iSubject) ;
load(resultFilePath)

% 指定された試行・条件のデータを抽出
Data   = DataArray(iTrial, iCondition) ;
Result = SingleTrialResultArray(iTrial, iCondition) ;

Prm = parameters ;

% フィルター処理
fs = Data.FrameRate ;
fc = Prm.Fc ;
[b, a] = butter(2, fc/(fs/2)) ;
M = filt_all_fields(b, a, Data.Markers) ;

% バットの先端(top)の合成速度を計算
top = M.top ;
velTop = diff3p(top, 1/fs) ;
netVelTop = sum(velTop.^2, 2).^0.5 ;

% グラフ描画のベース作成（合成速度とLED）
figure(1)
clf % グラフをクリアする

plotTimeRange = [-1, 3] ; % 表示範囲[秒]：LED点灯から-1~3秒

% 基準となるフレーム情報と時間軸の作成
tCueMarker = Result.TCueMarker ;
n = length(top) ;

% LED点灯フレーム(tCueMaker)を基準(0秒)とした時間軸[秒]の作成
if ~isnan(tCueMarker)
    tArray = ([1:n] - tCueMarker) / fs ; % 各フレーム番号からLED点灯フレームを引いた後、フレーム単位を[秒]に変換
else
    tArray = [1:n] / fs ; % LEDが検出できなかった場合の仮の時間軸
end

% --- 上段：バット先端の合成速度 ---
subplot(3, 1, 1:2) ;
plot(tArray, netVelTop, 'b-', 'LineWidth', 1.5) ;
hold on
ylabel('Velocity(mm/s)') ;
set(gca, 'xlim', plotTimeRange) ;
grid on

% --- 下段：LEDの電圧信号 ---
subplot(3, 1, 3) ;
nAnalog = length(Data.LEDData) ;
led = Data.LEDData(:, 2) ;

% LED電圧検出位置(アナログサンプル）
tCueAnalog = find(abs(led) > 2, 1, 'first')

% LED点灯(tCueAnalog)を基準(0秒)としたアナログ時間軸[秒]を作成
if ~isempty(tCueAnalog)
    tArrayAnalog = ([1:nAnalog] - tCueAnalog) / Data.AnalogFs ;
else
    tArrayAnalog = [1:nAnalog] / Data.AnalogFs ;
end

plot(tArrayAnalog, led, 'g-', 'LineWidth', 1.2)
xlabel('Time from LED onset(s)') ;
ylabel('Voltage(V)') ;
set(gca, 'xlim', plotTimeRange) ;
grid on

% スイング開始の赤縦線とタイトルの表示
subplot(3, 1, 1:2) ;

tSwingOnset = Result.SwingOnset ;
RT          = Result.RT ;
cueText     = Result.CueText ;

% スイング開始フレームの縦線を描く
if ~isnan(tSwingOnset) && ~isnan(tCueMarker)
    tSwingOnset_sec = (tSwingOnset - tCueMarker) /fs ;
    lineplot(tSwingOnset_sec, 'v', 'r-', 'LineWidth', 1.5) ;
end


% タイトルにRTとCue条件を表示
if ~isnan(RT)
    title(sprintf('Subject %d, Condition: %s, Trial %d\\nRT = %.1f ms(Cue: %s)'))